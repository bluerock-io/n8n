# ==============================================================================
# EXTENDED RUNNERS IMAGE WITH CLAUDE CODE
# ==============================================================================
# This Dockerfile extends the base n8nio/runners image with Claude Code CLI
# and additional dependencies for enhanced code analysis capabilities.
#
# Key additions:
# - Claude Code CLI for AI-powered code assistance
# - System tools: git, bash, curl, npm, npx
# - JavaScript dependencies: @anthropic-ai/claude-agent-sdk, @anthropic-ai/sdk, moment
# - Environment configured for Claude Code execution
# ==============================================================================

ARG BASE_IMAGE=n8nio/runners:latest

# Stage with full Alpine + Node.js to install tools and Claude Code
FROM node:22.21.0-alpine AS tools-installer

# Install comprehensive toolset for Claude Code static analysis
# Core utilities: git, bash, curl, wget
# Search tools: grep, find, ripgrep
# Archive tools: tar, unzip, gzip
# Text processing: jq (JSON), less, cat, head, tail
# Build tools: make (for analyzing build systems)
# Analysis: file (file type detection)
RUN apk add --no-cache \
    git \
    bash \
    curl \
    wget \
    grep \
    findutils \
    ripgrep \
    tar \
    unzip \
    gzip \
    jq \
    less \
    make \
    file \
    tree

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

FROM ${BASE_IMAGE}

# Switch to root for installations
USER root

# Copy all binaries from tools-installer
# Core utilities
COPY --from=tools-installer /usr/bin/git /usr/bin/git
COPY --from=tools-installer /bin/bash /bin/bash
COPY --from=tools-installer /usr/bin/curl /usr/bin/curl
COPY --from=tools-installer /usr/bin/wget /usr/bin/wget
COPY --from=tools-installer /usr/bin/rg /usr/bin/rg
COPY --from=tools-installer /usr/bin/jq /usr/bin/jq
COPY --from=tools-installer /usr/bin/less /usr/bin/less
COPY --from=tools-installer /usr/bin/make /usr/bin/make
COPY --from=tools-installer /usr/bin/file /usr/bin/file
COPY --from=tools-installer /usr/bin/tree /usr/bin/tree
COPY --from=tools-installer /usr/bin/find /usr/bin/find
COPY --from=tools-installer /usr/bin/xargs /usr/bin/xargs
COPY --from=tools-installer /bin/tar /bin/tar
COPY --from=tools-installer /usr/bin/unzip /usr/bin/unzip
COPY --from=tools-installer /bin/gzip /bin/gzip
COPY --from=tools-installer /bin/grep /bin/grep

# Node.js npm/npx with full dependencies
COPY --from=tools-installer /usr/local/bin/npm /usr/local/bin/npm
COPY --from=tools-installer /usr/local/bin/npx /usr/local/bin/npx
COPY --from=tools-installer /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

# Claude Code CLI with full dependencies
COPY --from=tools-installer /usr/local/lib/node_modules/@anthropic-ai/claude-code /usr/local/lib/node_modules/@anthropic-ai/claude-code
COPY --from=tools-installer /usr/local/bin/claude /usr/local/bin/claude

# Copy only the specific shared libraries needed by our tools
# CRITICAL: Copy libpcre2 FIRST because /bin/sh needs it to run any RUN commands
# Then we can use RUN commands for conditional copying of other libraries
COPY --from=tools-installer /usr/lib/libpcre2-8.so.* /usr/lib/

# Copy core network libraries with verbose logging (split for granularity)
RUN --mount=type=bind,from=tools-installer,source=/usr/lib,target=/src/usr/lib \
    set -e && \
    echo "=== Copying Core Network Libraries ===" && \
    echo "Copying libcurl..." && \
    (cp -a /src/usr/lib/libcurl.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libcurl copied" || echo "  [WARN] libcurl not found (continuing...)") && \
    echo "Copying libnghttp2..." && \
    (cp -a /src/usr/lib/libnghttp2.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libnghttp2 copied" || echo "  [WARN] libnghttp2 not found (continuing...)") && \
    echo "Copying libidn2..." && \
    (cp -a /src/usr/lib/libidn2.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libidn2 copied" || echo "  [WARN] libidn2 not found (continuing...)") && \
    echo "Copying libssh2..." && \
    (cp -a /src/usr/lib/libssh2.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libssh2 copied" || echo "  [WARN] libssh2 not found (continuing...)") && \
    echo "Copying libunistring..." && \
    (cp -a /src/usr/lib/libunistring.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libunistring copied" || echo "  [WARN] libunistring not found (continuing...)") && \
    echo "=== Core Network Libraries Complete ==="

# Copy SSL/TLS libraries
RUN --mount=type=bind,from=tools-installer,source=/usr/lib,target=/src/usr/lib \
    set -e && \
    echo "=== Copying SSL/TLS Libraries ===" && \
    echo "Copying libssl..." && \
    (cp -a /src/usr/lib/libssl.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libssl copied" || echo "  [WARN] libssl not found (continuing...)") && \
    echo "Copying libcrypto..." && \
    (cp -a /src/usr/lib/libcrypto.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libcrypto copied" || echo "  [WARN] libcrypto not found (continuing...)") && \
    echo "=== SSL/TLS Libraries Complete ==="

# Copy compression libraries
RUN --mount=type=bind,from=tools-installer,source=/usr/lib,target=/src/usr/lib \
    --mount=type=bind,from=tools-installer,source=/lib,target=/src/lib \
    set -e && \
    echo "=== Copying Compression Libraries ===" && \
    echo "Copying libz..." && \
    (cp -a /src/usr/lib/libz.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libz copied from /usr/lib" || \
     cp -a /src/lib/libz.so.* /lib/ 2>/dev/null && echo "  [OK] libz copied from /lib" || \
     echo "  [WARN] libz not found (continuing...)") && \
    echo "Copying libbz2..." && \
    (cp -a /src/usr/lib/libbz2.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libbz2 copied" || echo "  [WARN] libbz2 not found (continuing...)") && \
    echo "Copying liblzma..." && \
    (cp -a /src/usr/lib/liblzma.so.* /usr/lib/ 2>/dev/null && echo "  [OK] liblzma copied" || echo "  [WARN] liblzma not found (continuing...)") && \
    echo "=== Compression Libraries Complete ==="

# Copy tool-specific libraries
RUN --mount=type=bind,from=tools-installer,source=/usr/lib,target=/src/usr/lib \
    --mount=type=bind,from=tools-installer,source=/lib,target=/src/lib \
    set -e && \
    echo "=== Copying Tool-Specific Libraries ===" && \
    echo "Copying libonig (for jq)..." && \
    (cp -a /src/usr/lib/libonig.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libonig copied" || echo "  [WARN] libonig not found (continuing...)") && \
    echo "Copying libmagic (for file)..." && \
    (cp -a /src/usr/lib/libmagic.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libmagic copied" || echo "  [WARN] libmagic not found (continuing...)") && \
    echo "Copying libgcc_s..." && \
    (cp -a /src/lib/libgcc_s.so.* /lib/ 2>/dev/null && echo "  [OK] libgcc_s copied" || echo "  [WARN] libgcc_s not found (continuing...)") && \
    echo "Copying libstdc++..." && \
    (cp -a /src/usr/lib/libstdc++.so.* /usr/lib/ 2>/dev/null && echo "  [OK] libstdc++ copied" || echo "  [WARN] libstdc++ not found (continuing...)") && \
    echo "=== Tool-Specific Libraries Complete ==="

# Validate all installed tools work correctly
# This catches library dependency issues at build time rather than runtime
RUN set -ex && \
    echo "=== Validating Installed Tools ===" && \
    echo "git: $(git --version)" && \
    echo "bash: $(bash --version | head -1)" && \
    echo "curl: $(curl --version | head -1)" && \
    echo "wget: $(wget --version | head -1)" && \
    echo "grep: $(grep --version | head -1)" && \
    echo "find: $(find --version | head -1)" && \
    echo "xargs: $(xargs --version | head -1)" && \
    echo "rg: $(rg --version)" && \
    echo "tar: $(tar --version | head -1)" && \
    echo "unzip: $(unzip -v | head -1)" && \
    echo "gzip: $(gzip --version | head -1)" && \
    echo "jq: $(jq --version)" && \
    echo "less: $(less --version | head -1)" && \
    echo "make: $(make --version | head -1)" && \
    echo "file: $(file --version)" && \
    echo "tree: $(tree --version)" && \
    echo "npm: $(npm --version)" && \
    echo "npx: $(npx --version)" && \
    echo "claude: $(claude --version)" && \
    echo "=== All Tools Validated Successfully ==="

# Add JavaScript dependencies for Claude Agent SDK to a separate location
# Keep the original node_modules (has task-runner's core deps from pnpm)
# Install our extras to /opt/extra-modules and add to NODE_PATH
RUN mkdir -p /opt/extra-modules && \
    cd /opt/extra-modules && \
    npm init -y && \
    npm install --legacy-peer-deps \
    @anthropic-ai/claude-agent-sdk@latest \
    @anthropic-ai/sdk@latest \
    moment@2.30.1

# Change default shell to bash (required by Claude Code)
ENV SHELL=/bin/bash

# Ensure claude is executable and create config directory for runner user
RUN chmod +x /usr/local/bin/claude && \
    mkdir -p /home/runner/.config/claude && \
    chown -R runner:runner /home/runner/.config

# Switch back to runner user
USER runner
WORKDIR /home/runner

# Metadata
LABEL org.opencontainers.image.title="n8n task runners with Claude Code" \
      org.opencontainers.image.description="Extended n8n task runners image with Claude Code CLI and AI capabilities" \
      org.opencontainers.image.source="https://github.com/bluerock-io/n8n" \
      org.opencontainers.image.url="https://n8n.io"
