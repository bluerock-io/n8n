# ==============================================================================
# EXTENDED RUNNERS IMAGE WITH CLAUDE CODE
# ==============================================================================
# This Dockerfile extends the base n8nio/runners image with Claude Code CLI
# and additional dependencies for enhanced code analysis capabilities.
#
# Key additions:
# - Claude Code CLI for AI-powered code assistance
# - System tools: git, bash, curl, npm, npx
# - JavaScript dependencies: @anthropic-ai/claude-agent-sdk, @anthropic-ai/sdk, moment
# - Environment configured for Claude Code execution
# ==============================================================================

ARG BASE_IMAGE=n8nio/runners:latest

# Stage to install tools - using same Python Alpine base as runtime image
# This ensures library compatibility (same Alpine version = compatible libraries)
FROM python:3.13-alpine AS tools-installer

# Install Node.js first (needed for npm and Claude Code CLI)
RUN apk add --no-cache nodejs npm

# Install comprehensive toolset for Claude Code static analysis
# Core utilities: git, bash, curl, wget
# Search tools: grep, find, ripgrep
# Archive tools: tar, unzip, gzip
# Text processing: jq (JSON), less, cat, head, tail
# Build tools: make (for analyzing build systems)
# Analysis: file (file type detection)
RUN apk add --no-cache \
    git \
    bash \
    curl \
    wget \
    grep \
    findutils \
    ripgrep \
    tar \
    unzip \
    gzip \
    jq \
    less \
    make \
    file \
    tree

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Install Claude Agent SDK and extra packages to separate directory
# These will be copied to /opt/extra-modules in the final image
RUN mkdir -p /opt/extra-modules && \
    cd /opt/extra-modules && \
    npm init -y && \
    npm install --legacy-peer-deps \
    @anthropic-ai/claude-agent-sdk@latest \
    @anthropic-ai/sdk@latest \
    moment@2.30.1

FROM ${BASE_IMAGE}

# Switch to root for installations
USER root

# Create /tmp directory with proper permissions for runner user
# Must be done BEFORE any library copies (Kaniko RUN bug)
RUN mkdir -p /tmp && chmod 1777 /tmp

# Copy all binaries from tools-installer
# Core utilities
COPY --from=tools-installer /usr/bin/git /usr/bin/git
COPY --from=tools-installer /bin/bash /bin/bash
COPY --from=tools-installer /usr/bin/curl /usr/bin/curl
COPY --from=tools-installer /usr/bin/wget /usr/bin/wget
COPY --from=tools-installer /usr/bin/rg /usr/bin/rg
COPY --from=tools-installer /usr/bin/jq /usr/bin/jq
COPY --from=tools-installer /usr/bin/less /usr/bin/less
COPY --from=tools-installer /usr/bin/make /usr/bin/make
COPY --from=tools-installer /usr/bin/file /usr/bin/file
COPY --from=tools-installer /usr/bin/tree /usr/bin/tree
COPY --from=tools-installer /usr/bin/find /usr/bin/find
COPY --from=tools-installer /usr/bin/xargs /usr/bin/xargs
COPY --from=tools-installer /bin/tar /bin/tar
COPY --from=tools-installer /usr/bin/unzip /usr/bin/unzip
COPY --from=tools-installer /bin/gzip /bin/gzip
COPY --from=tools-installer /bin/grep /bin/grep

# Node.js npm/npx with full dependencies
COPY --from=tools-installer /usr/local/bin/npm /usr/local/bin/npm
COPY --from=tools-installer /usr/local/bin/npx /usr/local/bin/npx
COPY --from=tools-installer /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

# Claude Code CLI with full dependencies
COPY --from=tools-installer /usr/local/lib/node_modules/@anthropic-ai/claude-code /usr/local/lib/node_modules/@anthropic-ai/claude-code
COPY --from=tools-installer /usr/local/bin/claude /usr/local/bin/claude

# Copy all required shared libraries from tools-installer
# Using simple COPY commands instead of RUN with bind mounts to avoid execution issues
# Core PCRE library (MUST be first - needed by /bin/sh)
COPY --from=tools-installer /usr/lib/libpcre2-8.so.* /usr/lib/

# Network libraries (for curl, wget, git)
COPY --from=tools-installer /usr/lib/libcurl.so.* /usr/lib/
COPY --from=tools-installer /usr/lib/libnghttp2.so.* /usr/lib/
COPY --from=tools-installer /usr/lib/libidn2.so.* /usr/lib/
COPY --from=tools-installer /usr/lib/libunistring.so.* /usr/lib/

# SSL/TLS libraries (for HTTPS)
COPY --from=tools-installer /usr/lib/libssl.so.* /usr/lib/
COPY --from=tools-installer /usr/lib/libcrypto.so.* /usr/lib/

# Tool-specific libraries
COPY --from=tools-installer /usr/lib/libonig.so.* /usr/lib/
COPY --from=tools-installer /usr/lib/libmagic.so.* /usr/lib/
COPY --from=tools-installer /usr/lib/libstdc++.so.* /usr/lib/

# Note: Skipping libz, libbz2, liblzma, libgcc_s, libssh2:
# - libz: Already in base image (causes symlink conflicts)
# - libbz2, liblzma: Not installed in tools-installer
# - libgcc_s: Not in tools-installer /lib
# - libssh2: Not installed (git doesn't need SSH for our use case)
# Base image's compression libraries are sufficient

# Copy JavaScript dependencies for Claude Agent SDK from tools-installer
# These were installed in tools-installer to avoid Kaniko RUN issues
COPY --from=tools-installer /opt/extra-modules /opt/extra-modules

# Change default shell to bash (required by Claude Code)
ENV SHELL=/bin/bash

# Switch back to runner user
USER runner
WORKDIR /home/runner

# Metadata
LABEL org.opencontainers.image.title="n8n task runners with Claude Code" \
      org.opencontainers.image.description="Extended n8n task runners image with Claude Code CLI and AI capabilities" \
      org.opencontainers.image.source="https://github.com/bluerock-io/n8n" \
      org.opencontainers.image.url="https://n8n.io"
